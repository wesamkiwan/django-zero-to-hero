# Copy this file to .env and fill in real values. .env is gitignored —
# NEVER commit real secrets. Every variable here has a safe fallback in
# settings.py, so a fresh clone works with no .env file at all; write one
# once you need to override a default (e.g. to test production-like
# settings locally, or for a real deployment — see Module 16).

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True locally, False in any real deployment.
DEBUG=True

# Comma-separated, no spaces. Required (and enforced by check --deploy)
# whenever DEBUG=False.
ALLOWED_HOSTS=

# Only read when DEBUG=False (see settings.py) — CELERY_TASK_ALWAYS_EAGER
# is never read from here; it's derived from whether pytest is running
# (see Module 13's lesson for why).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
