# Copy this file to .env and fill in real values. .env is gitignored —
# NEVER commit real secrets. Every variable here has a safe fallback in
# settings.py, so a fresh clone works with no .env file at all; write one
# once you need to override a default (e.g. to test production-like
# settings locally, or for a real deployment — see Module 16).

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True locally, False in any real deployment.
DEBUG=True

# Comma-separated, no spaces. Required (and enforced by check --deploy)
# whenever DEBUG=False.
ALLOWED_HOSTS=

# CELERY_TASK_ALWAYS_EAGER is never read from here — it's derived from
# whether pytest is running (see Module 13's lesson for why). These two
# are overridden to redis://redis:6379/0 inside docker-compose.yml
# ("localhost" means something different from inside a container).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- PostgreSQL (Module 16) ---
# Leave all four blank to keep using SQLite (zero setup, matches every
# earlier module). docker-compose.yml sets these for every container it
# starts, and overrides POSTGRES_HOST to "db" (the service name) since
# "localhost" means something different from inside a container.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Object storage (Module 16) ---
# Leave blank to keep using local disk for uploaded product images
# (fine for this course's docker-compose.yml, wrong for a real
# multi-container deployment — see the Module 16 lesson for why).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Real AWS credentials go in AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY —
# boto3's OWN env vars, deliberately not Django settings (see settings.py).
